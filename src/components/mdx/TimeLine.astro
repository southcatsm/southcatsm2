---
import { Icon } from "astro-icon/components";

interface TimelineItem {
	year: string;
	event: string;
	icon?: string; 
	details?: string; 
}

interface Props {
	items: TimelineItem[];
}

const { items } = Astro.props;
const defIcons = [
	"lucide:rocket",
	"lucide:code",
	"lucide:hammer",
	"lucide:sparkles",
	"lucide:git-branch"
];
---

<ul class="not-prose timeline timeline-vertical timeline-snap-icon max-w-4xl mx-auto my-8 px-4">
	{
		items.map((item, index) => {
			const icon = item.icon || defIcons[index % defIcons.length];
			return (
				<li class="group relative mb-12 last:mb-0">
					{index !== 0 && <hr class="bg-gradient-to-b from-base-300 to-transparent h-8 opacity-50" />}
				  
					<div class="timeline-middle">
						<div class="relative bg-gradient-to-br from-primary to-secondary rounded-full p-2 shadow-lg 
						shadow-primary/30 group-hover:shadow-xl transition-all duration-300 group-hover:scale-110">
							<Icon name={icon} class="w-6 h-6 text-primary-content" />
							{item.details && (
								<div class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs opacity-0 
								group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap">
									{item.year}
								</div>
							)}
						</div>
					</div>
				  
					<div class={`timeline-${index % 2 === 0 ? 'end' : 'start'} timeline-box bg-base-200 shadow-md 
					group-hover:shadow-xl transition-all duration-300 relative overflow-hidden`}>
						<div class="absolute inset-0 bg-gradient-to-r from-primary/10 to-transparent 
						opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						<div class="relative z-10">
							<p class="font-bold text-lg mb-1">{item.event}</p>
							{item.details && (
								<p class="text-sm text-base-content/70 group-hover:text-base-content transition-colors duration-300">
									{item.details}
								</p>
							)}
						</div>
					</div>
				  
					<div class={`timeline-${index % 2 === 0 ? 'start' : 'end'} mb-4`}>
						<time class="font-mono font-semibold text-lg bg-gradient-to-r from-primary 
						to-secondary bg-clip-text text-transparent">
							{item.year}
						</time>
					</div>
					<hr class="bg-base-300 dark:bg-base-700" />
				</li>	
			)
		})
	}
</ul>

<style>
	.timeline-box {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.timeline-box:hover {
		transform: translateY(-3px);
	}
</style>